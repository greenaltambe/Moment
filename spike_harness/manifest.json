{
  "manifest_version": 3,
  "name": "Moment Intervention Spike Harness",
  "version": "1.1.0",
  "description": "Disposable test harness for intervention routing validation",
  "browser_specific_settings": {
    "gecko": {
      "id": "moment-spike@moment.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "webNavigation",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "web_accessible_resources": [
    {
      "resources": ["intervene.html", "intervene.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
