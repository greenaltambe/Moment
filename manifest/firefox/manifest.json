{
  "manifest_version": 3,
  "name": "Moment — Intentional Website Blocker",
  "version": "1.1.0",
  "description": "Create a moment between impulse and action. A research-informed, privacy-first intentionality tool.",
  "browser_specific_settings": {
    "gecko": {
      "id": "moment@moment.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "background": {
    "scripts": ["background/index.js"],
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup/popup.html",
    "default_title": "Moment"
  },
  "options_ui": {
    "page": "ui/options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/intervene/intervene.html",
        "ui/intervene/intervene.js",
        "ui/intervene/intervene.css",
        "ui/block/block.html",
        "ui/block/block.js",
        "ui/block/block.css",
        "ui/theme.css",
        "ui/theme.js",
        "shared/urls.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none';"
  }
}
